# ============================================================================
#  YN Finance ORB Bot — environment configuration
#  Copy to .env and fill in. NEVER commit the real .env.
# ============================================================================

# ---- Tradovate environment -------------------------------------------------
# demo = simulated (paper). live = real money / funded prop account.
# KEEP THIS ON demo UNTIL YOU HAVE WATCHED IT TRADE A FULL SESSION.
TRADOVATE_ENV=demo

# ---- Tradovate / prop-firm credentials -------------------------------------
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=YN Finance ORB Bot
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SECRET=
# Any stable unique string (a UUID is fine). Identifies this machine.
TRADOVATE_DEVICE_ID=yn-orb-bot-device-01

# ---- Account to trade ------------------------------------------------------
# Your prop-firm account. Leave ID blank to auto-resolve from the account list.
TRADOVATE_ACCOUNT_SPEC=
TRADOVATE_ACCOUNT_ID=

# ---- Instrument ------------------------------------------------------------
# Front-month contract symbol, e.g. MNQM5, NQU5, ESU5, MESU5
SYMBOL=MNQM5
# Point value ($ per 1.0 price point per contract). MNQ=2, NQ=20, ES=50, MES=5
POINT_VALUE=2
# Contracts per trade (full position before any scale-out)
QUANTITY=1

# ---- Market-data feed (drives the backend strategy) ------------------------
# yahoo     = free Yahoo Finance, NO key. DELAYED ~10-15m -> paper/validation
#             only. NQ=F drives MNQ signals at the same price.
# tradovate = Tradovate market-data WebSocket (needs a Tradovate API key).
# none      = no internal feed; signals come from a TradingView webhook
#             (TradingView Essential plan + $7/mo CME real-time data for live).
DATA_FEED=yahoo
# Yahoo ticker for the feed (e.g. NQ=F, ES=F). Blank = auto from SYMBOL.
DATA_SYMBOL=

# ---- Execution route -------------------------------------------------------
# "tradovate"   = direct Tradovate API key (needs a funded live account).
# "traderspost" = webhook bridge — works with Lucid Trading and other prop
#                 firms WITHOUT a broker API key. Recommended for prop accounts.
BROKER=traderspost
# Your TradersPost strategy webhook URL (TradersPost -> Strategies -> Webhook).
TRADERSPOST_WEBHOOK_URL=
# Ticker as your TradersPost broker connection expects it (e.g. MNQU2025).
# Leave blank to fall back to SYMBOL.
TRADERSPOST_TICKER=

# ---- Execution toggle ------------------------------------------------------
# false = log signals only (safe). true = actually send live orders.
AUTO_TRADE=false

# ============================================================================
#  Strategy parameters — mirror the Pine Script inputs
# ============================================================================
STRATEGY_TIMEZONE=America/Los_Angeles
STRATEGY_SESSION=0630-1300
STRATEGY_OR_CANDLES=3
STRATEGY_DEPARTURE_PTS=15
STRATEGY_CONFIRM_CLOSE=true
STRATEGY_STOP_PTS=50
STRATEGY_TP_PTS=100
STRATEGY_ONE_TRADE=true
STRATEGY_USE_VWAP=true
STRATEGY_USE_PARTIAL=true
STRATEGY_PARTIAL_PCT=50

# ---- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/orb_bot.sqlite
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
